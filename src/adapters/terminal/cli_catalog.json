      },
      "launch_flags": [],
      "mcp": {
        "method": "flag",
        "format": "claude_mcp_json",
        "argv": ["--mcp-config", "{mcp_config_file}"],
        "verified": true,
        "note": "Verificado con el binario local (2.1.309): `--mcp-config <archivo>` con mcpServers.<n>.{type:http,url,headers}; el Hub embebido respondio 200 con el token del panel. No se usa --strict-mcp-config para respetar los MCP del usuario."
      },
      "resume": {
        "argv": ["--continue"],
        "verified": true,
        "note": "Verificado con `claude --help` local: -c/--continue y -r/--resume <id>."
      },
      "install": {
        "linux": [
          {
            "method": "npm",
            "command": "npm install -g @anthropic-ai/claude-code@latest",
            "verified": true,
            "source_url": "https://code.claude.com/docs/en/setup",
            "note": "Requiere Node.js 22+ segun la documentacion oficial; no usar sudo."
          },
          {
            "method": "curl_sh",
            "command": "curl -fsSL https://claude.ai/install.sh | bash",
            "verified": true,

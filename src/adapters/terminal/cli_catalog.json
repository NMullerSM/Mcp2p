      "candidate_paths": {
        "linux": ["~/.local/bin/claude", "~/.config/Claude/claude-code/*/*/claude"],
        "darwin": ["~/.local/bin/claude", "~/Library/Application Support/Claude/claude-code/*/*/claude"],
